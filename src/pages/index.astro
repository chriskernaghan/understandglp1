---
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import { getPriceMeta } from '../lib/price-meta.js';

// Read at build time. The daily price commit triggers a rebuild,
// so the date and provider count stay current in the static HTML.
const priceMeta = getPriceMeta();
---
<BaseLayout
  title="Understand GLP-1 — Real Life on GLP-1 Medications"
  description="Understand GLP-1 — real news, honest stories, and practical food guides for people on Ozempic, Wegovy, Mounjaro, Zepbound and more. Built for your GLP-1 life."
  canonicalPath="/"
  overlayNav
>

<div class="hero-shell">
  <picture class="hero-bg" aria-hidden="true">
    <source media="(max-width: 640px)" srcset="/images/hero-home-800.webp" />
    <img src="/images/hero-home-1920.webp"
         srcset="/images/hero-home-1200.webp 1200w, /images/hero-home-1920.webp 1920w"
         sizes="100vw" alt="" width="1920" height="1280"
         fetchpriority="high" decoding="async" />
  </picture>
<section class="hero">
  <div class="hero-label anim-up">Real life on GLP-1</div>
  <h1 class="anim-up anim-up-d1">News, stories &amp; food<br>for your <em>GLP-1 journey</em></h1>
  <p class="hero-sub anim-up anim-up-d2">From breaking research to what's for dinner tonight — honest, practical coverage built for people actually on Ozempic, Wegovy, Mounjaro, and more.</p>
  <div class="hero-actions anim-up anim-up-d3">
    <a href="/stories" class="btn-primary">Read Real Stories →</a>
    <a href="/blog" class="btn-secondary">Latest News</a>
  </div>
  <div class="hero-trust anim-up anim-up-d4">Independent and evidence-based. Not affiliated with any pharmaceutical company.</div>
</section>
</div>

<section class="pillars"><div class="section-wrap">
  <div class="pillars-header anim-up anim-up-d4">
    <h2>Everything in one place</h2>
    <p>From breaking research to what's for dinner tonight — we cover the full GLP-1 journey.</p>
  </div>
  <div class="pillar-grid">
    <a href="/blog" class="pillar-card anim-up anim-up-d3"><div><span class="pillar-card__icon">📰</span><div class="pillar-card__title">News &amp; Industry</div><div class="pillar-card__desc">FDA decisions, clinical trials, pricing changes, and the latest research — as it happens.</div></div><span class="pillar-card__arrow">↗</span></a>
    <a href="/stories" class="pillar-card anim-up anim-up-d4"><div><span class="pillar-card__icon">💬</span><div class="pillar-card__title">Real Stories</div><div class="pillar-card__desc">First-hand experiences from real people on their GLP-1 journey — the highs, the lows, and everything in between.</div></div><span class="pillar-card__arrow">↗</span></a>
    <a href="/food" class="pillar-card anim-up anim-up-d5"><div><span class="pillar-card__icon">🥗</span><div class="pillar-card__title">Food &amp; Nutrition</div><div class="pillar-card__desc">Recipes, meal plans, and practical eating guides designed for life on GLP-1 and GLP-2 medications.</div></div><span class="pillar-card__arrow">↗</span></a>
    <a href="/#medications" class="pillar-card anim-up anim-up-d6"><div><span class="pillar-card__icon">📖</span><div class="pillar-card__title">Reference Wiki</div><div class="pillar-card__desc">Deep-dive guides on every medication — how they work, dosing, side effects, cost, and comparisons.</div></div><span class="pillar-card__arrow">↗</span></a>
  </div>
</div></section>

<section class="price-band"><div class="section-wrap">
  <div class="price-band__card">
    <div class="price-band__copy">
      <div class="price-band__label">UK price comparison</div>
      <h2>Wegovy &amp; Mounjaro prices, <em>checked daily</em></h2>
      <p>Already prescribed? See what UK online pharmacies and weight-loss programmes charge each month, with consultation, delivery and current new-patient codes factored in.</p>
      {priceMeta && (
        <div class="price-band__meta">
          <span>{priceMeta.providerCount} UK providers</span>
          <span>Starting and top doses</span>
          <span>Checked {priceMeta.lastVerified}</span>
        </div>
      )}
    </div>
    <div class="price-band__action">
      <a href="/uk-glp1-price-comparison" class="btn-primary">Compare UK prices →</a>
      <p class="price-band__note">Prescription-only medicines. Always confirm the final price with the provider.</p>
    </div>
  </div>
</div></section>

<section class="latest"><div class="section-wrap">
  <div class="latest-header"><h2>Latest news</h2><a href="/blog">View all articles →</a></div>
  <div class="news-grid">
    <a href="/glp1-plateau" class="news-feature">
      <div class="news-feature__img">📉</div>
      <div class="news-feature__body">
        <div class="news-feature__cat">Diet &amp; Nutrition</div>
        <div class="news-feature__title">The GLP-1 Plateau: Why Your Weight Loss Stopped (And How to Restart It)</div>
        <div class="news-feature__excerpt">Hit a weight loss plateau on Wegovy, Ozempic, or Mounjaro? Learn the biological reasons why your body stops losing weight on GLP-1s and evidence-based steps to restart your progress.</div>
        <div class="news-feature__meta">Apr 22, 2026 · 12 min read</div>
      </div>
    </a>

    <a href="/muscle-loss" class="news-card">
      <div><div class="news-card__cat">Side Effects</div><div class="news-card__title">The Muscle Loss Problem on GLP-1s</div><div class="news-card__excerpt">Learn why GLP-1 medications can deplete lean mass and the exact steps to protect your metabolism while losing weight.</div></div>
      <div class="news-card__meta">Apr 21, 2026 · 10 min read</div>
    </a>

    <a href="/travelling-on-glp1" class="news-card">
      <div><div class="news-card__cat">Lifestyle</div><div class="news-card__title">Traveling on a GLP-1: Airport Security &amp; Vacation Eating</div><div class="news-card__excerpt">Your complete guide to getting pens through airport security, refrigeration rules, and navigating holiday buffets without getting sick.</div></div>
      <div class="news-card__meta">Apr 18, 2026 · 8 min read</div>
    </a>
  </div>
</div></section>

<section class="stories"><div class="section-wrap">
  <div class="stories-header"><h2>Real stories, real people</h2><p>First-hand accounts from people navigating GLP-1 medications. Unfiltered and honest.</p></div>
  <div class="story-grid">
    <a href="/story-sarah-wegovy-8-months" class="story-card"><div class="story-card__quote">"</div><div class="story-card__text">The food noise disappearing was the biggest shock. For the first time in 30 years, I wasn't thinking about my next meal constantly.</div><div class="story-card__author">Sarah M.</div><div class="story-card__detail">On Wegovy · 8 months · Lost 47 lbs</div></a>
    <a href="/story-james-ozempic-to-mounjaro" class="story-card"><div class="story-card__quote">"</div><div class="story-card__text">I was skeptical about Mounjaro after Ozempic made me so nauseous. The switch was night and day — way fewer side effects for me.</div><div class="story-card__author">James R.</div><div class="story-card__detail">Switched from Ozempic to Mounjaro · 6 months</div></a>
    <a href="/story-priya-zepbound-protein" class="story-card"><div class="story-card__quote">"</div><div class="story-card__text">Nobody tells you how hard it is to eat enough protein when your appetite is this low. I wish I'd started tracking macros from day one.</div><div class="story-card__author">Priya K.</div><div class="story-card__detail">On Zepbound · 4 months · Lost 32 lbs</div></a>
  </div>
</div></section>

<section class="food"><div class="section-wrap">
  <div class="food-header"><h2>Food &amp; nutrition</h2><a href="/food">See all guides →</a></div>
  <div class="food-grid">
    <a href="/food-high-protein-breakfasts" class="food-card"><div class="food-card__img">🥚</div><div class="food-card__body"><div class="food-card__tag">High Protein</div><div class="food-card__title">10 Quick High-Protein Breakfasts for Low Appetite Days</div><div class="food-card__desc">When eating feels like a chore, these 200–400 calorie breakfasts pack maximum nutrition into minimum volume.</div></div></a>
    <a href="/food-weekly-meal-plan" class="food-card"><div class="food-card__img">🍲</div><div class="food-card__body"><div class="food-card__tag">Meal Plan</div><div class="food-card__title">The 1,200–1,500 Calorie GLP-1 Meal Plan</div><div class="food-card__desc">A week of balanced meals designed around the reduced appetite and nutritional needs of GLP-1 patients.</div></div></a>
    <a href="/food-what-makes-side-effects-worse" class="food-card"><div class="food-card__img">🚫</div><div class="food-card__body"><div class="food-card__tag">What to Avoid</div><div class="food-card__title">Foods That Make GLP-1 Side Effects Worse</div><div class="food-card__desc">Greasy, fried, and high-sugar foods can amplify nausea and GI issues. Here's what to skip and what to eat instead.</div></div></a>
  </div>
</div></section>

<section class="meds-strip" id="medications"><div class="section-wrap">
  <div class="meds-strip-header"><h2>Medication reference</h2><p>Deep-dive guides on every GLP-1 and GLP-2 medication — how they work, dosing, cost, and side effects.</p></div>
  <a href="/semaglutide" class="med-row"><div class="med-row__name">Semaglutide</div><div class="med-row__brands">Ozempic · Wegovy · Rybelsus</div><span class="med-row__arrow">→</span></a>
  <a href="/tirzepatide" class="med-row"><div class="med-row__name">Tirzepatide</div><div class="med-row__brands">Mounjaro · Zepbound</div><span class="med-row__arrow">→</span></a>
  <a href="/liraglutide" class="med-row"><div class="med-row__name">Liraglutide</div><div class="med-row__brands">Victoza · Saxenda</div><span class="med-row__arrow">→</span></a>
  <a href="/dulaglutide" class="med-row"><div class="med-row__name">Dulaglutide</div><div class="med-row__brands">Trulicity</div><span class="med-row__arrow">→</span></a>
  <a href="#" class="med-row"><div class="med-row__name">GLP-2</div><div class="med-row__brands">Teduglutide · Gattex</div><span class="med-row__arrow">→</span></a>
</div></section>

<section class="newsletter"><div class="newsletter-inner">
  <h2>Stay in the loop</h2>
  <p>A weekly digest of GLP-1 news, stories, and nutrition tips — written for real people, not medical journals.</p>
  <NewsletterForm class="newsletter-form" buttonLabel="Subscribe" placeholder="Your email address" />
  <div class="newsletter-trust">No spam, ever. Unsubscribe anytime. <a href="/privacy">Privacy policy</a></div>
</div></section>

<section class="inline-cta-strip"><div class="section-wrap"><div class="inline-cta-inner">
  <div><h3>Compare GLP-1 telehealth platforms</h3><p>US and UK platforms compared side-by-side — cost, medications, and app support, so you can choose the right service.</p></div>
  <a href="/glp1-telehealth-platforms-compared" class="btn-primary">Compare Platforms →</a>
</div></div></section>

</BaseLayout>
